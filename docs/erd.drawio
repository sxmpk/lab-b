<mxfile host="app.diagrams.net"><diagram name="Pogodynka ERD" id="weather-erd"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1654" pageHeight="1169"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="locality" value="locality&#10;&#10;PK  id : INTEGER&#10;    name : VARCHAR(120) NOT NULL&#10;    country_code : CHAR(2) NOT NULL&#10;    latitude : DECIMAL(8,5) NOT NULL&#10;    longitude : DECIMAL(8,5) NOT NULL" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Courier New;fontSize=20;fillColor=#eef4fb;strokeColor=#224c74;"><mxGeometry as="geometry" x="70" y="190" width="540" height="270" /></mxCell><mxCell id="weather_reading" value="weather_reading&#10;&#10;PK  id : INTEGER&#10;FK  locality_id : INTEGER NOT NULL&#10;    measured_at : DATETIME NOT NULL (UTC)&#10;    temperature_c : DECIMAL(5,2) NOT NULL&#10;    humidity_percent : DECIMAL(5,2) NULL&#10;    pressure_hpa : DECIMAL(6,2) NULL&#10;    wind_speed_mps : DECIMAL(6,2) NULL&#10;    precipitation_mm : DECIMAL(7,2) NULL&#10;UQ  (locality_id, measured_at)" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Courier New;fontSize=20;fillColor=#eef4fb;strokeColor=#224c74;"><mxGeometry as="geometry" x="880" y="190" width="650" height="414" /></mxCell><mxCell id="relationship" value="1 : N" edge="1" parent="1" source="locality" target="weather_reading" style="edgeStyle=orthogonalEdgeStyle;startArrow=ERone;endArrow=ERmany;startFill=0;endFill=0;exitX=1;exitY=0.4;entryX=0;entryY=0.25;fontSize=24;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="notes" value="Model flat: jeden wiersz = pomiar w miejscowości w danej chwili.&#10;Każdy pomiar należy do jednej miejscowości; miejscowość ma 0..N pomiarów.&#10;Temperatura: °C. Brak pomiaru opcjonalnego = NULL, nigdy 0.&#10;CHECK: latitude [-90,90], longitude [-180,180], temperature_c &gt;= -273.15.&#10;CHECK: humidity_percent [0,100], pressure_hpa &gt; 0, wind_speed_mps &gt;= 0, precipitation_mm &gt;= 0.&#10;FK locality_id → locality.id; ON DELETE RESTRICT. UQ zapobiega powielaniu pomiarów." vertex="1" parent="1" style="text;whiteSpace=wrap;html=0;align=left;fontSize=20;verticalAlign=top;"><mxGeometry as="geometry" x="70" y="680" width="1470" height="240" /></mxCell></root></mxGraphModel></diagram></mxfile>