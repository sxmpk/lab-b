{% extends 'base.html.twig' %}

{% block title %}Measurement{% endblock %}

{% block body %}
    <h1>Pomiar</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ measurement.id }}</td>
            </tr>
            <tr>
                <th>Data</th>
                <td>{{ measurement.date ? measurement.date|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Temperatura (°C)</th>
                <td>{{ measurement.celsius }}</td>
            </tr>
            <tr>
                <th>Wilgotność (%)</th>
                <td>{{ measurement.humidity }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_measurement_index') }}">Powrót do listy</a>

    <a href="{{ path('app_measurement_edit', {'id': measurement.id}) }}">Edytuj</a>

    {{ include('measurement/_delete_form.html.twig') }}
{% endblock %}
